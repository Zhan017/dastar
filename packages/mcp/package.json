{
  "name": "@dastar/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "An MCP server over stdio for one Dastar venue: search availability, hold, cancel, and read reservations through the reference API",
  "type": "module",
  "bin": { "dastar-mcp": "dist/dastar-mcp.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@dastar/agent-tools": "workspace:*",
    "@dastar/api": "workspace:*",
    "@dastar/client": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
